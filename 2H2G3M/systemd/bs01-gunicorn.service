[Unit]
Description=BS01 Django Backend (ASGI via Uvicorn) - 2C2G tuned
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/BS01/backend
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=backend.settings
EnvironmentFile=/root/BS01/backend/.env
ExecStart=/root/BS01/.venv/bin/uvicorn backend.asgi:application --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
