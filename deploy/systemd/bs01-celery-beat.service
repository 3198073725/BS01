[Unit]
Description=BS01 Celery Beat Scheduler
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_ROOT__/backend
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=backend.settings
EnvironmentFile=__PROJECT_ROOT__/backend/.env
ExecStart=__PROJECT_ROOT__/.venv/bin/celery -A backend beat -l INFO
# If you install django-celery-beat, you can switch to database scheduler:
# ExecStart=__PROJECT_ROOT__/.venv/bin/celery -A backend beat -l INFO --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=always
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
