[Unit]
Description=BS01 Django Backend (ASGI via Uvicorn)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_ROOT__/backend
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=backend.settings
EnvironmentFile=__PROJECT_ROOT__/backend/.env
ExecStart=__PROJECT_ROOT__/.venv/bin/uvicorn backend.asgi:application --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
