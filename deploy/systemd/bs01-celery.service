[Unit]
Description=BS01 Celery Worker (default queue)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_ROOT__/backend
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=backend.settings
EnvironmentFile=__PROJECT_ROOT__/backend/.env
ExecStart=__PROJECT_ROOT__/.venv/bin/celery -A backend worker -l INFO -Q default -c 4
Restart=always
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
